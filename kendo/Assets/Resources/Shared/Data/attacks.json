      "label": "MEN",
      "impactFrame": 82,
      "defenderRetreat": 60,
      "retreatDelay": 0,
      "target": "menTop",
      /* Kamae, seme et furikaburi sont le même geste pour les trois coupes qui
         s'arment : en jeu le kendoka arme d'abord, et choisit ensuite. La
         frappe reprend donc à la frame où l'armé est tenu. */
      "requiresArming": true,
      "armedFrame": 58,
      /* Petite amplitude : appuyée pendant la montée, la touche arrête l'armé et
         reprend la coupe ici, la main gauche à 150 cm au lieu des 179 du sommet.
         La frame se lit sur la descente, seul endroit où la main repasse par une
         hauteur d'armé écourté ; celle-ci a été choisie à l'image, entre f76 (lame
         encore verticale) et l'impact. */
      "smallAmplitudeFrame": 78,
      /* En jeu la touche Armer ne joue pas la frame 0 : elle joue la montée, qui
         commence à la frame où les mains quittent la garde. Les quarante-quatre
         frames de kamae et de seme qui précèdent sont écrites pour la coupe jouée
         d'un bloc, où elles racontent l'entrée ; sous le doigt du joueur elles ne
         sont qu'un délai avant que quoi que ce soit bouge. Et le seme qu'elles
         contiennent est le déplacement du joueur, qui l'a déjà fait au swipe. */
      "raiseFrame": 44,
      "keyframeList": [
        {
          /* Garde haute : bassin à 90,5 cm, la limite au-delà de laquelle le pied
             avant ne toucherait plus le sol. La jambe gauche y est tendue à 95,6 %,
             prête à propulser. */
