      /* ------------------------------------------------------------
         Kote : même geste que le men, mais visant l'avant-bras droit
         de l'adversaire. Cible plus basse et plus proche de 28 cm, donc
         armé plus court, avance réduite de 112 à 115 cm, et lame qui
         finit inclinée vers le bas au lieu de monter vers la tête.
         ------------------------------------------------------------ */
      "id": "kote",
      "label": "KOTE",
      "impactFrame": 82,
      "defenderRetreat": 40,
      "retreatDelay": 0,
      "target": "rightForearm",
      "requiresArming": true,
      "armedFrame": 58,
      /* Petite amplitude : main gauche à 130 cm, la pointe déjà piquée vers le
         kote. Le kote finissant bas, il en reste vingt-sept centimètres de fente
         écrits, contre trente au men. */
      "smallAmplitudeFrame": 76,
      /* Le kote est le coup court : la lame a moitié moins de chemin à tomber que
         sur un men, et autant de frames pour le faire. Écrit tel quel il traîne.
